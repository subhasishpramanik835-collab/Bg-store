rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Server-side role verification via Firebase Custom Claims & Admin Emails
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') in ['admin', 'super_admin'] ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('super_admin', false) == true ||
        request.auth.token.email.lower() in ['subhasishpramanik835@gmail.com', 'asishp92@gmail.com']
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Draws collection
    match /draws/{drawId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deposits collection
    match /deposits/{depositId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Connection test document
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
